/*Gothic Vampire Mode*/
:root {

  /*Here you add your own variables*/
  --themebgdark: #1D0502;
  --themebglight: #3A120C;
  --themeprimarytext: #B47F79;
  --themesecondarytext: #C39F97;
  --themeiconcolor: RBG(91 55 51);
  --themetint: #E1C7F0;
  
  --font-family: "Caslon FS", "Book Antiqua", Palatino, serif;

  /*you can leave this alone*/
  --white-on-dark: #FAEBD8;
  --chrome: var(--themebgdark);
  --chrome-panel: #1D0502;
  --modal: #1D0502;
  --content-panel: #3A120C;
  --content-fg: #B47F79;
  --chrome-fg: #B47F79;
  --content-fg-secondary: #B47F79;
  --chrome-fg-secondary: #B47F79;
  --content-fg-tertiary: #C39F97;
  --chrome-fg-tertiary: #C39F97;
  --chrome-ui: #B47F79;
  --chrome-ui-pressed: #B47F79;
  --accent: #B47F79;
  --accent-tint-heavy: #B47F79;
  --content-ui: #B47F79;
  --chrome-ui-hover: #B47F79;
  --content-ui-hover: #B47F79;
  --content-purple: #423154;
  --brand-purple-tint-strong: #E1C7F0;
  --brand-red: #B47F79;
  --brand-red-pressed: #B47F79;
  --brand-red-pressed: #B47F79;
  --brand-orange: #B47F79;
  --brand-green: #B47F79;
  --brand-green-pressed: #B47F79;
  --brand-green-hover: #B47F79;
  --brand-blue: #B47F79;
  --brand-blue-pressed: #B47F79;
  --brand-blue-hover: #B47F79;
  --brand-purple: #B47F79;
  --brand-pink: #B47F79;
} 

.SbeG8.Mk7yS svg use {
  --icon-color-primary: #B47F79;
}

.uOpMe > a:nth-child(1) > img:nth-child(1) {
display: none;
}

.wttFd svg , .ADK9v svg , .EvhBA svg {
 --black: 91 55 51;
 --red: 91 55 51;
 --yellow: 91 55 51;
 --green: 91 55 51;
 --blue: 91 55 51;
 --pink: 91 55 51;
 --purple: 91 55 51;
 --orange: 91 55 51;
}

#managed-icon__logo-tumblr > path {
--icon-color-primary: #B47F79;
}

