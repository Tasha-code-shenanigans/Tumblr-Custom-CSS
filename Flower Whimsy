/*Burgundy Flower Mode*/
:root {

  /*Here you add your own color variables*/
  --themebgdark: #5E3935;
  --themebglight: #664242;
  --themeprimarytext: #D4AD90;
  --themesecondarytext: #C39F97;
  --themetertiarytext: #E9D3CE;
  --themeiconcolor: 245 222 179; /*this one needs to be in RGB*/
  --themetint: #E1C7F0;
  
  --font-family: "Caslon FS", "Book Antiqua", Palatino, serif;

  /*you can leave everything after this alone*/
  --chrome: var(--themebgdark);
  --chrome-panel: var(--themebgdark);
  --modal: var(--themebgdark);
  --content-panel: var(--themebglight);
  --content-fg: var(--themeprimarytext);
  --chrome-fg: var(--themeprimarytext);
  --content-fg-secondary: var(--themesecondarytext);
  --chrome-fg-secondary: var(--themesecondarytext);
  --content-fg-tertiary: var(--themetertiarytext);
  --chrome-fg-tertiary: var(--themetertiarytext);
  --chrome-ui: var(--themeprimarytext);
  --chrome-ui-pressed: var(--themeprimarytext);
  --accent: var(--themeprimarytext);
  --accent-tint-heavy: var(--themeprimarytext);
  --deprecated-accent: var(--themeiconcolor);
  --content-ui: var(--themeprimarytext);
  --chrome-ui-hover: var(--themeprimarytext);
  --content-ui-hover: var(--themeprimarytext);
  --brand-purple-tint-strong: var(--themetint);
  --brand-red: var(--themeprimarytext);
  --brand-red-pressed: var(--themeprimarytext);
  --brand-red-pressed: var(--themeprimarytext);
  --brand-orange: var(--themeprimarytext);
  --brand-green: var(--themeprimarytext);
  --brand-green-pressed: var(--themeprimarytext);
  --brand-green-hover: var(--themeprimarytext);
  --brand-blue: var(--themeprimarytext);
  --brand-blue-pressed: var(--themeprimarytext);
  --brand-blue-hover: var(--themeprimarytext);
  --brand-purple: var(--themeprimarytext);
  --brand-pink: var(--themeprimarytext);
} 

.SbeG8.Mk7yS svg use {
  --icon-color-primary: var(--themeprimarytext);
}

.uOpMe > a:nth-child(1) > img:nth-child(1) {
display: none;
}

.wttFd svg , .ADK9v svg , .EvhBA svg {
 --black: var(--themeiconcolor);
 --red: var(--themeiconcolor);
 --yellow: var(--themeiconcolor);
 --green: var(--themeiconcolor);
 --blue: var(--themeiconcolor);
 --pink: var(--themeiconcolor);
 --purple: var(--themeiconcolor);
 --orange: var(--themeiconcolor);
}

#managed-icon__logo-tumblr > path {
--icon-color-primary: var(--themeprimarytext);
}

/*Flower BG*/
.D5eCV {
  background: var(--chrome);
  background-image: url("https://i.postimg.cc/RZWH5vCm/Untitled327-20260806185403.png");
  background-blend-mode: normal;
  background-size: 30% auto;
  background-repeat: repeat;
}
